-- @TITLE@. Generado por build_live_voices.py; ver README de este experimento.
-- A/B/C/D timbre por voz: toro / Roman / doble cono / Cassini.
-- E tempo .5–1.5x; F expresion 0–1; G giro (0 pausa). Sin efectos/LFO de host incluidos.
-- FOCUS=0: mezcla sonora, NO superficie. FOCUS>0: XYZ de una voz, audio geometrico sin filtrar.
local ID='@ID@'
local FOCUS=@FOCUS@
local LIVE=@LIVE@
@GEOMETRY@
if not live_voices or live_voices.id~=ID or live_voices.rate~=sample_rate or step<live_voices.last then
 live_voices={id=ID,rate=sample_rate,last=step,time=0,seconds=0,index=1,active={},speed=1,expression=.65,angle=.65,
 cycles=0,duration=@DURATION@,notes=@NOTES@,banks=@BANKS@,defaults=@DEFAULTS@,mix={},selected={},max_hz=0}
 for i,bank in ipairs(live_voices.defaults) do
  live_voices.mix[i]={0,0,0,0};live_voices.mix[i][bank]=1;live_voices.selected[i]=bank
 end
end
local s=live_voices;s.last=step;local dt=1/sample_rate;local k=1-math.exp(-dt/.08)
local function control(v,d) if not LIVE or type(v)~='number' or v~=v then return d end;return math.max(0,math.min(1,v)) end
local controls={slider_a,slider_b,slider_c,slider_d}
for i,bank in ipairs(s.defaults) do
 local value=control(controls[i],(bank-.5)/4)
 -- Histeresis de .012: evita disparos repetidos por jitter MIDI cerca del umbral.
 local selected=s.selected[i]
 if value<(selected-1)/4-.012 or value>selected/4+.012 then selected=math.min(4,1+math.floor(value*4)) end
 s.selected[i]=selected
 for b=1,4 do s.mix[i][b]=s.mix[i][b]+k*((b==selected and 1 or 0)-s.mix[i][b]) end
end
s.speed=s.speed+k*(.5+control(slider_e,.5)-s.speed)
s.expression=s.expression+k*(control(slider_f,.65)-s.expression)
s.angle=s.angle+.2*control(slider_g,.5)*dt
local t=s.time
if t>=s.duration then
 t=t%s.duration;s.time=t;s.seconds=0;s.index=1;s.active={};s.cycles=s.cycles+1
end
s.time=s.time+dt*s.speed;s.seconds=s.seconds+dt
while s.notes[s.index] and s.notes[s.index][1]<=t do
 local n=s.notes[s.index];s.active[#s.active+1]={note=n,phase=0};s.index=s.index+1
end
local function ease(v) v=math.max(0,math.min(1,v));return v*v*(3-2*v) end
local x,y=0,0;local selected_voice=nil
for j=#s.active,1,-1 do
 local voice=s.active[j];local n=voice.note
 if t>=n[2] then table.remove(s.active,j)
 else
  local ins=n[5];local age=(t-n[1])/s.speed;local remaining=(n[2]-t)/s.speed
  local env=ease(age/.065)*ease(remaining/.09)
  local hz=440*2^((n[3]-69)/12);voice.phase=(voice.phase+hz*dt)%1
  local band=1
  for b,h in ipairs({2,4,8,12}) do if h*hz<sample_rate*.42 then band=b end end
  s.max_hz=math.max(s.max_hz,({2,4,8,12})[band]*hz)
  if FOCUS==0 then
   local pos=voice.phase*512;local ix=math.floor(pos);local f=pos-ix;local a,b=ix+1,(ix+1)%512+1
   local vx,vy=0,0
   for bank=1,4 do
    local weight=s.mix[ins][bank]
    if weight>1e-6 then
     local tab=s.banks[bank][band]
     vx=vx+weight*(tab[1][a]*(1-f)+tab[1][b]*f)
     vy=vy+weight*(tab[2][a]*(1-f)+tab[2][b]*f)
    end
   end
   local gain=.12*s.expression*(n[4]/127)*env
   x=x+gain*vx;y=y+gain*vy
  elseif ins==FOCUS and (not selected_voice or n[3]>selected_voice.note[3]) then
   selected_voice=voice;voice.env=env
  end
 end
end
local fade=ease(s.seconds/.08)*ease((s.duration-t)/(.1*s.speed))
if FOCUS==0 then return {x*fade,y*fade,0} end
if not selected_voice then return {0,0,0} end
local voice=selected_voice;local kind=s.selected[FOCUS]
-- Cobertura independiente: 7 Hz; portadora ligada a la nota. No se filtra XYZ.
local gx,gy,gz=geometry(kind,2*math.pi*voice.phase,2*math.pi*(s.seconds*7%1))
local gain=.7/bounds[kind]*voice.env*s.expression*fade
s.geometry_kind=kind;s.geometry_gain=gain;s.raw={gx,gy,gz}
return orient(gx,gy,gz,s.angle,gain)
