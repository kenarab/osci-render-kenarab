-- @TITLE@ / MED-01…06. A forma B giro C registro D cobertura E expresión F brillo G espacio H respiración.
-- XYZ mantiene la superficie. AUDIO es mezcla estéreo derivada, no geometría.
local ID='@ID@';local LIVE=@LIVE@;local AUDIO=@AUDIO@;local KIND=@KIND@
@GEOMETRY@
local function shape_point(u,v,a)
 if KIND<3 then return lobed_point(KIND,u,v,.5+@RANGE@*a) end
 local x,y,z=math.cos(v)*math.cos(u),math.cos(v)*math.sin(u),math.sin(v)
 return y*z*(.7+.6*a),x*z,x*y
end
local function shape_bound(a)
 if KIND<3 then return lobed_bound(KIND,.5+@RANGE@*a) end
 return .5*math.sqrt((.7+.6*a)^2+2)
end
if not meditation or meditation.id~=ID or meditation.rate~=sample_rate or step<meditation.last then
 meditation={id=ID,rate=sample_rate,last=step,time=0,angle=.65,u=0,v=0,shape=@SHAPE@,
 hz=@HZ@,cover=7,expression=.65,bright=.28,space=.35,breath=.4,
 phases={0,.17,.37,.61},dl={},dr={},il=1,ir=1,lowL=0,lowR=0,
 nl=math.floor(sample_rate*.271),nr=math.floor(sample_rate*.337),banks=@BANKS@}
end
local s=meditation;s.last=step;local dt=1/sample_rate;local smooth=1-math.exp(-dt/.15)
local function ctl(v,d) if not LIVE or type(v)~='number' or v~=v then return d end;return math.max(0,math.min(1,v)) end
local function chase(key,target) s[key]=s[key]+smooth*(target-s[key]) end
chase('shape',ctl(slider_a,@SHAPE@));chase('hz',55*2^ctl(slider_c,@REGISTER@))
chase('cover',4.3+5.4*ctl(slider_d,.5));chase('expression',ctl(slider_e,.65))
chase('bright',ctl(slider_f,.28));chase('space',ctl(slider_g,.35));chase('breath',ctl(slider_h,.4))
s.angle=s.angle+.12*ctl(slider_b,.4)*dt;s.time=s.time+dt
s.u=(s.u+s.hz*dt)%1;s.v=(s.v+s.cover*dt)%1
local function ease(x) x=math.max(0,math.min(1,x));return x*x*(3-2*x) end
local startup=ease(s.time/1.5)
if not AUDIO then
 local x,y,z=shape_point(2*math.pi*s.u,2*math.pi*s.v,s.shape)
 s.raw={x,y,z};s.gain=.76*s.expression*startup/shape_bound(s.shape)
 local c,sn=math.cos(s.angle),math.sin(s.angle);local xx,zz=c*x+sn*z,-sn*x+c*z
 local cp,sp=math.cos(.45),math.sin(.45)
 return {s.gain*xx,s.gain*(cp*y-sp*zz),s.gain*(sp*y+cp*zz)}
end
-- Bancos de ocho geometrías, cuatro bandas, dos brillos y dos canales.
local frame=s.shape*7;local f0=math.floor(frame)+1;local f1=math.min(8,f0+1);local mix=frame-math.floor(frame)
local function wave(phase,band,channel)
 local pos=phase*256;local ix=math.floor(pos)+1;local next=ix%256+1;local frac=pos-math.floor(pos)
 local function at(f,t)
  local bank=s.banks[f][band][t][channel];return bank[ix]*(1-frac)+bank[next]*frac
 end
 local a=at(f0,1)*(1-s.bright)+at(f0,2)*s.bright
 local b=at(f1,1)*(1-s.bright)+at(f1,2)*s.bright
 return a*(1-mix)+b*mix
end
-- Transición continua entre dos acordes, sin reataques ni saltos de fase.
local period=@PERIOD@+50*(1-s.breath);local cycle=.5-.5*math.cos(2*math.pi*s.time/period)
local ratios={1,1.5,2^((@THIRD@+cycle*2)/12),2^((@SEVENTH@+cycle)/12)}
local weights={.48,.22,.18,.12};local x,y=0,0
for voice=1,4 do
 local hz=s.hz*ratios[voice]*(1+.0007*math.sin(s.time*(.21+voice*.031)+voice))
 s.phases[voice]=(s.phases[voice]+hz*dt)%1
 local band=1;for b,h in ipairs({2,4,8,12}) do if h*hz<sample_rate*.4 then band=b end end
 local swell=1-.28*s.breath+.28*s.breath*math.sin(2*math.pi*s.time/(12+voice*3)+voice)
 local phase=(s.phases[voice]+.008*s.bright*math.sin(s.time*.43+voice))%1
 x=x+weights[voice]*swell*wave(phase,band,1)
 y=y+weights[voice]*swell*wave((phase+.003*voice)%1,band,2)
end
-- Dos resonadores retardados con feedback amortiguado. No son modos físicos de la superficie.
local l,r=s.dl[s.il] or 0,s.dr[s.ir] or 0
local lp=1-math.exp(-2*math.pi*(700+2400*s.bright)*dt)
s.lowL=s.lowL+lp*(l-s.lowL);s.lowR=s.lowR+lp*(r-s.lowR)
s.dl[s.il]=.35*x+.62*s.lowR;s.dr[s.ir]=.35*y+.62*s.lowL
s.il=s.il%s.nl+1;s.ir=s.ir%s.nr+1
local gain=.38*s.expression*startup
return {gain*((1-.3*s.space)*x+.3*s.space*l),gain*((1-.3*s.space)*y+.3*s.space*r),0}
