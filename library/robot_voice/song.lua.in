-- @TITLE@: arreglo MIDI completo disponible, no fidelidad certificada al disco.
-- A melodia, B acompañamiento, C bajo: toro/Roman/Cassini/robot (centros .125/.375/.625/.875).
-- D bateria, E tempo .5–1.5x, F expresion (0=mute), G vocal a/e/i/o/u, H brillo robot.
local LIVE=@LIVE@
local ID='@ID@'
-- Las fábricas sólo se invocan al inicializar: no reconstruir datos por muestra.
@LOADERS@
if not daft_song or daft_song.id~=ID or daft_song.rate~=sample_rate or step<daft_song.last then
 daft_song={id=ID,rate=sample_rate,last=step,time=0,seconds=0,index=1,active={},speed=1,expression=.7,drums=.65,vowel=1,bright=.5,
 done=false,processed=0,duration=@DURATION@,notes=load_notes(),banks=load_banks(),formants=load_formants(),mix={{0,0,0,1},{1,0,0,0},{0,1,0,0}},selected={4,1,2}}
end
local s=daft_song;s.last=step;local dt=1/sample_rate;local smooth=1-math.exp(-dt/.08)
local function ctl(v,d) if not LIVE or type(v)~='number' or v~=v then return d end;return math.max(0,math.min(1,v)) end
local selectors={ctl(slider_a,.875),ctl(slider_b,.125),ctl(slider_c,.375)}
for ins=1,3 do
 local b=s.selected[ins];local v=selectors[ins]
 if v<(b-1)/4-.012 or v>b/4+.012 then b=math.min(4,1+math.floor(v*4)) end
 s.selected[ins]=b
 for j=1,4 do s.mix[ins][j]=s.mix[ins][j]+smooth*((b==j and 1 or 0)-s.mix[ins][j]) end
end
s.speed=s.speed+smooth*(.5+ctl(slider_e,.5)-s.speed)
s.expression=s.expression+smooth*(ctl(slider_f,.7)-s.expression)
s.drums=s.drums+smooth*(ctl(slider_d,.65)-s.drums)
s.vowel=s.vowel+smooth*(1+4*ctl(slider_g,.25)-s.vowel)
s.bright=s.bright+smooth*(ctl(slider_h,.5)-s.bright)
local t=s.time;s.time=t+dt*s.speed;s.seconds=s.seconds+dt
if t>=s.duration then s.done=true;return {0,0,0} end
while s.notes[s.index] and s.notes[s.index][1]<=t do
 local n=s.notes[s.index];s.active[#s.active+1]={n=n,phase=0};s.index=s.index+1;s.processed=s.processed+1
end
local function ease(v) v=math.max(0,math.min(1,v));return v*v*(3-2*v) end
local x,y=0,0
for j=#s.active,1,-1 do
 local voice=s.active[j];local n=voice.n
 if t>=n[2] then table.remove(s.active,j)
 else
  local ins=n[5];local age=(t-n[1])/s.speed;local remaining=(n[2]-t)/s.speed
  local vx,vy,env=0,0,1
  if ins==4 then
   local p=n[3]
   if p==35 or p==36 then
    vx=math.sin(2*math.pi*(48*age+62*.025*(1-math.exp(-age/.025))))*math.exp(-age/.11)
   elseif p==38 or p==40 or p==39 then
    vx=(math.sin(2*math.pi*183*age)+.5*math.sin(2*math.pi*1273*age)+.4*math.sin(2*math.pi*2119*age))/1.9*math.exp(-age/.065)
   else
    vx=(math.sin(2*math.pi*3109*age)+math.sin(2*math.pi*4237*age)+math.sin(2*math.pi*5573*age))/3*math.exp(-age/(p==46 and .09 or .025))
   end
   vx=vx*ease(age/.002)*ease(remaining/.006)*s.drums;vy=.75*vx
  else
   local hz=440*2^((n[3]-69)/12);voice.phase=(voice.phase+hz*dt)%1
   env=ease(age/.025)*ease(remaining/.05)
   local band=1;for b,h in ipairs({2,4,8,12}) do if h*hz<sample_rate*.42 then band=b end end
   local pos=voice.phase*512;local ix=math.floor(pos);local f=pos-ix;local a,b=ix+1,(ix+1)%512+1
   for bank=1,3 do
    local w=s.mix[ins][bank]
    if w>1e-6 then local tab=s.banks[bank][band];vx=vx+w*(tab[1][a]*(1-f)+tab[1][b]*f);vy=vy+w*(tab[2][a]*(1-f)+tab[2][b]*f) end
   end
   local weight=s.mix[ins][4]
   if weight>1e-6 then
    local vowel=math.min(4,math.floor(s.vowel));local alpha=s.vowel-vowel
    local aa,bb=s.formants[n[3]+1][vowel],s.formants[n[3]+1][vowel+1]
    local p=2*math.pi*voice.phase;local sn,cs=math.sin(p),math.cos(p);local sh,ch=sn,cs
    for h=1,32 do
     if h*hz<sample_rate*.4 then
      local w=(aa[h]*(1-alpha)+bb[h]*alpha)/(1+(1-s.bright)*.07*(h-1))
      vx=vx+weight*w*sh;vy=vy+weight*w*ch
     end
     sh,ch=sh*cs+ch*sn,ch*cs-sh*sn
    end
   end
  end
  local gain=@GAIN@*s.expression*(n[4]/127)*env
  x=x+gain*vx;y=y+gain*vy
 end
end
local fade=ease(s.seconds/.06)*ease((s.duration-t)/(.1*s.speed))
return {x*fade,y*fade,0} -- Mezcla derivada: no superficie algebraica XYZ.
