-- AIRE EXPRESIVO / Cuatro voces en el espacio — sobre J. S. Bach, BWV 1068/II.
-- Fuente Mutopia 242, edición jeff covey, CC BY-SA 3.0; ver SOURCE.md.
-- Archivo generado por scripts/build_bach_air.py. Editar este motor y regenerar.
-- En osci-render: abrir aire-expresivo.lua (preset) o aire-control.lua (sliders). Ver README.
local TAKE = 201
local USAR_SLIDERS = @LIVE@
if not bach_air or bach_air.interpretation ~= "expresivo" or bach_air.take ~= TAKE or bach_air.rate ~= sample_rate
    or step < bach_air.last then
    bach_air = {
        interpretation="expresivo", take=TAKE, rate=sample_rate, last=step, beat=0, seconds=0,
        camera=0, a=0.375,b=0.65,c=0.45,d=0.7,e=0.2, done=false,
        defaults={0.375,0.65,0.45,0.7,0.2},
        notes=@SCORE@,
        voices={}, weights={0.40,0.145,0.125,0.23},
        turns={2,3,4,2}, radii={0.05,0.14,0.20,0.18},
        cutoff={2.2,4.0,2.8,1.6}, vibrato_hz={4.7,5.05,4.4,3.7},
        vibrato_depth={0.055,0.035,0.025,0.012},
        tilt={0.15,0.65,-0.5,0.9}, offsets={0,0.5,1.2,2.0}, endings={24,48,96,144}
    }
    for i=1,4 do
        bach_air.voices[i]={index=1,phase=0,vphase=0,fx=0,fy=0,fz=0}
    end
    function bach_air.smooth(a,b,x)
        local t=math.max(0,math.min(1,(x-a)/(b-a)))
        return t*t*(3-2*t)
    end
    function bach_air.control(old,value,k)
        if type(value)~="number" or value~=value or math.abs(value)==math.huge then return old end
        return old+k*(math.max(0,math.min(1,value))-old)
    end
end
local s=bach_air
s.last=step
local dt=1/sample_rate
local k=1-math.exp(-dt/0.08)
local a,b,c,d,e
if USAR_SLIDERS then a,b,c,d,e=slider_a,slider_b,slider_c,slider_d,slider_e
else a,b,c,d,e=s.defaults[1],s.defaults[2],s.defaults[3],s.defaults[4],s.defaults[5] end
s.a=s.control(s.a,a,k); s.b=s.control(s.b,b,k); s.c=s.control(s.c,c,k)
s.d=s.control(s.d,d,k); s.e=s.control(s.e,e,k)
if s.beat>=144 then s.done=true; return {0,0,0} end
local beat=s.beat
-- Respiración de cada compás y cadencias. El tempo se integra sin saltar notas.
local barphase=(beat%8)/8
local rubato=1+0.05*s.b*math.sin(2*math.pi*barphase)
local cadence=0
for _,ending in ipairs(s.endings) do
    if beat>ending-3 and beat<ending+1 then
        cadence=s.smooth(ending-3,ending-0.25,beat)
            *(1-s.smooth(ending,ending+1,beat))
    end
end
local rit=1-(0.04+0.20*s.b)*cadence-(0.10+0.20*s.b)*s.smooth(140,144,beat)
local base_bpm=20+32*s.a
s.base_bpm=base_bpm
local bps=base_bpm/60*rubato*rit
s.beat=s.beat+bps*dt
s.seconds=s.seconds+dt
s.camera=(s.camera+dt*0.009)%(2*math.pi)

-- Cuatro episodios continuos: hilo, bóveda, penumbra y luz.
local opening=s.smooth(20,36,beat)
local shadow=s.smooth(48,64,beat)*(1-s.smooth(90,110,beat))
local light=s.smooth(96,124,beat)
local color=0.60+0.80*s.c
local width=0.78+0.10*opening
local phrase=1-s.b*(0.26-0.26*math.sin(math.pi*(beat%8)/8)^2)
local globalfade=s.smooth(0,0.28,s.seconds)
local finalfade=1-s.smooth(143.15,144,beat)
local x,y,z=0,0,0
for i=1,4 do
    local voice=s.voices[i]
    local notes=s.notes[i]
    while notes[voice.index] and beat>=notes[voice.index][2] do
        voice.index=voice.index+1
    end
    local event=notes[voice.index]
    local tx,ty,tz=0,0,0
    if event and beat>=event[1] then
        local start,finish,pitch=event[1],event[2],event[3]
        local duration=(finish-start)/bps
        local delay=i==1 and 0 or s.b*0.014*(0.5+0.5*math.sin(voice.index*1.7+i))
        local age=(beat-start)/bps-delay
        local articulated_finish=start+(finish-start)*(0.82+0.18*s.d)
        local remain=(articulated_finish-beat)/bps
        local attack=math.min(0.025+0.065*s.d+(i==1 and 0.025 or 0),duration*0.18)
        local release=math.min(0.035+0.075*s.d,duration*0.18)
        local env=s.smooth(0,attack,age)*s.smooth(0,release,remain)
        -- Cada voz tiene respiración y vibrato propios, integrados y reproducibles.
        local vrate=s.vibrato_hz[i]+0.12*math.sin(s.seconds*0.43+i)
        voice.vphase=(voice.vphase+2*math.pi*vrate*dt)%(2*math.pi)
        local vibrato=s.b*s.vibrato_depth[i]*s.smooth(0.25,0.9,age)*math.sin(voice.vphase)
        local hz=440*2^((pitch-69+vibrato)/12)
        local theta=voice.phase
        voice.phase=(theta+2*math.pi*hz*dt)%(2*math.pi)
        -- Perfiles por voz: v=N*theta, N=2/3/4/2; radios y filtros diferentes.
        -- Cada punto cumple el polinomio del toro antes de cámara/mezcla.
        local u=theta
        local v=s.turns[i]*theta+s.offsets[i]+0.12*s.b*math.sin(beat*math.pi/24)
        local R,r=0.78,s.radii[i]*color*(0.95+0.05*phrase)
        local gx=(R+r*math.cos(v))*math.cos(u)
        local gy=(R+r*math.cos(v))*math.sin(u)
        local gz=r*math.sin(v)
        local tilt=s.tilt[i]+0.28*shadow+0.15*math.sin(beat*math.pi/48)
        local yy=gy*math.cos(tilt)-gz*math.sin(tilt)
        local zz=gy*math.sin(tilt)+gz*math.cos(tilt)
        local xx=gx*math.cos(s.camera)+zz*math.sin(s.camera)
        zz=-gx*math.sin(s.camera)+zz*math.cos(s.camera)
        local focus=i==1 and (1+0.12*s.e) or (1-0.80*s.e)
        local orchestration=i==1 and 1 or (0.80+0.12*opening+0.08*light)
        -- Arco dentro de las notas largas y respiración de la frase, sin ruido.
        local swell=1+0.12*s.b*math.sin(math.pi*(beat-start)/(finish-start))^2
        local nuance=1+s.b*0.035*math.sin(voice.index*2.1+i)
        local breath=(i==4 and (0.97-0.05*s.b) or phrase)*(1-0.12*s.b*cadence)*swell*nuance
        local gain=s.weights[i]*env*focus*orchestration*breath
        tx,ty,tz=gain*xx,gain*yy,gain*zz
        voice.hz=hz
        voice.gx,voice.gy,voice.gz,voice.radius=gx,gy,gz,r
    end
    -- Color por voz; filtrar la señal modifica su XY, no conserva el punto del toro.
    local cutoff=math.min(8000,(voice.hz or 220)*s.cutoff[i]*(0.75+0.5*s.c))
    local lowpass=1-math.exp(-2*math.pi*cutoff*dt)
    voice.fx=voice.fx+lowpass*(tx-voice.fx)
    voice.fy=voice.fy+lowpass*(ty-voice.fy)
    voice.fz=voice.fz+lowpass*(tz-voice.fz)
    x=x+voice.fx; y=y+voice.fy; z=z+voice.fz
end
-- La suma polifónica es una trayectoria resultante; no son cuatro dibujos separados.
local gain=0.90*globalfade*finalfade
return {gain*x,gain*width*y,gain*z}
